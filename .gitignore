# Secrets and local configuration. Only the placeholder template is tracked.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

.venv/
__pycache__/
*.pyc

# Runtime database and every backup/snapshot of it: they hold trade history,
# the encrypted API secret and (in pre-PK-18 copies) plaintext session tokens.
backend/kite_terminal.db
backend/kite_terminal.db-*
backend/kite_terminal.db.bak
backend/kite_terminal*.bak
backend/kite_terminal*_bak
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.bak
*_bak
# SQLite sidecars of a backup (a read-only open of a WAL-mode backup creates them): account data too.
*_bak-wal
*_bak-shm
*_bak-journal

backend/ui_prefs.json
# Phase 2: the single-instance lock file (<DB_PATH>.instance.lock)
backend/*.instance.lock

# Captured live broker payloads (debugging) must never be committed.
captures/
*.har

# PK-22E: rotating application logs (python -m backend.server)
logs/

# Audit / readiness evidence reports (V12 final readiness and later): local evidence, never committed.
output/

# Post-V12 closure: everything the terminal and db_maintenance write beside the database (installation record,
# migrate-v12 / restore / rollback audits, verification records, in-progress markers): operational evidence.
backend/kite_terminal.db*
