# Kite Terminal configuration template. Copy to .env and fill in.
# .env is git-ignored; never commit real values. Placeholders only here.

# Kite Connect app credentials (developers.kite.trade). Read once, when the
# database is first created, to seed the account row; the secret is then
# stored Fernet-encrypted in the database.
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Fernet key that encrypts the API secret and the daily access token in the
# database. Generated and appended to .env on first run if unset. For a VM,
# prefer supplying it from the service environment (outside this directory);
# a value already in the process environment is never overridden by .env.
# KITE_TERMINAL_ENCRYPTION_KEY=

# --- Deployment (docs/DEPLOYMENT.md). Defaults are local-only and safe. ---
# Bind address and port for `python -m backend.server`.
# KITE_TERMINAL_HOST=127.0.0.1
# KITE_TERMINAL_PORT=8000
# A non-loopback bind is refused unless this is 1. The app has no login:
# only enable it behind a firewall and a VPN/SSH tunnel or TLS proxy.
# KITE_TERMINAL_ALLOW_REMOTE_BIND=0
# Extra hostnames the browser may use to reach the terminal (comma-separated,
# no wildcards). localhost, 127.0.0.1 and ::1 are always allowed.
# KITE_TERMINAL_ALLOWED_HOSTS=
# Address(es) of a trusted reverse proxy whose X-Forwarded-Proto/For headers
# may be honoured. Empty = proxy headers ignored.
# KITE_TERMINAL_TRUSTED_PROXY_IPS=
# Development only: restart on file changes. Never with live trading.
# KITE_TERMINAL_DEV_RELOAD=0
